  "window_sets": {
    "full": "all 1,215 windows of 965 units; the seven trained baselines have forecasts for 710 of them only and are 'not available' here",
    "late": "the 710 windows (710 units) after the training cutoff for which all seven trained baselines have a forecast; chosen by window identity, not by any target or forecast value"
