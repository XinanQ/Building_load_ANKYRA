  "temperature_input": "Temperature before the start of the temperature record is set to a constant 15 °C. The archived 1.x forecasts had copied a later year into that gap. 'ANKYRA-1x-matched' is 1.x recomputed on the same input as 2.0.1; 'ANKYRA-1x-archived' is the earlier 1.x forecast.",
  "definitions": {
    "log_ratio": "unit-equal log RMS ratio of the hourly errors, ANKYRA over the named model; negative favours ANKYRA (in same_information_check the ratio is the named model over ANKYRA, so negative favours the model)",
    "um_low, um_high": "95% interval of log_ratio from 2,000 bootstrap draws that resample units and target months independently",
    "improvement_pct": "100 * (1 - exp(log_ratio))",
    "pooled_mse_ratio": "ratio of the two mean squared errors over all windows; a different summary from log_ratio",
    "bootstrap_one_sided_p_unadjusted": "one-sided p-value from the centred bootstrap for the hypothesis that the forecaster in the numerator is not better; not adjusted for the number of comparisons",
    "bootstrap_zero_draws, bootstrap_empty_draws": "draws in which a unit had exactly zero error (the log ratio is then undefined) and draws without data; both are 0 in every entry",
    "units": "all units of the window set are kept; an exactly zero error would not be replaced by a small number",
    "RIDGE-L": "the per-unit ridge regression"
  },
